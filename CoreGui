local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/Library.lua"))()

-- ตั้งค่าธีมให้เป็นโทนเข้มทันสมัย (Dark Mode)
local Window = Library:CreateWindow({
    Title = "MARU STYLE HUB",
    Center = true,
    AutoShow = true,
    Size = UDim2.fromOffset(500, 350)
})

-- สร้าง Tabs (เมนูด้านข้าง) เหมือนในรูป
local MainTab = Window:AddTab("Main")
local WaveTab = Window:AddTab("Wave")

-- เพิ่มส่วนประกอบในหน้า Main
local MainBox = MainTab:AddLeftGroupbox("Settings")
MainBox:AddSlider("FlyHeight", {Text = "Fly Height", Min = 0, Max = 500, Default = 235})
MainBox:AddSlider("SafeTime", {Text = "Safe Time Finish", Min = 0, Max = 60, Default = 27})
MainBox:AddInput("StreakLimit", {Text = "Streak Limit", Default = ""})
MainBox:AddToggle("AutoDie", {Text = "Auto Die When Streak Reached", Default = false})

-- ปรับแต่งสีให้เหมือนรูป
Library:SetTheme("DarkTheme")
Library.AccentColor = Color3.fromRGB(0, 150, 255) -- สีฟ้าสว่าง
