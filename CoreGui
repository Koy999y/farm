-- EXTREME STABLE FARM - NO UI BUGS
_G.FarmActive = false

local TweenService = game:GetService("TweenService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- ฟังก์ชันฟาร์มที่เขียนใหม่ให้กระชับและไม่ค้าง
local function StartFarm()
    local Points = {Vector3.new(0, 0, -200), Vector3.new(0, 0, -1000), Vector3.new(0, 0, -9000)}
    while _G.FarmActive do
        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        if Root then
            for _, pos in pairs(Points) do
                if not _G.FarmActive then break end
                local Tween = TweenService:Create(Root, TweenInfo.new(5, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
                Tween:Play()
                Tween.Completed:Wait()
            end
            task.wait(1)
            if Char:FindFirstChild("Humanoid") then Char.Humanoid.Health = 0 end
            task.wait(2)
        end
        task.wait(0.5)
    end
end

-- สร้าง UI แบบง่ายที่สุดเพื่อกันบั๊ก "กดไม่ได้"
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 200, 0, 100)
Frame.Position = UDim2.new(0.5, -100, 0.5, -50)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

local Button = Instance.new("TextButton", Frame)
Button.Size = UDim2.new(1, 0, 1, 0)
Button.Text = "START FARMING"
Button.TextColor3 = Color3.fromRGB(0, 255, 255)
Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

Button.MouseButton1Click:Connect(function()
    _G.FarmActive = not _G.FarmActive
    Button.Text = _G.FarmActive and "STOP FARMING" or "START FARMING"
    if _G.FarmActive then task.spawn(StartFarm) end
end)
